# features.fluteos.claude-code — the Claude Code CLI, its hooks, and the MCP
# servers registered for every session.
#
# Options live in ./options.nix; the MCP activation script is generated by
# ./mcp-setup.nix from features.fluteos.claude-code.mcpServers.
#
# FluteOS registers the two servers that are about writing software: semantic
# code search over your checkouts, and web research. Everything that speaks for
# an ACCOUNT of yours — a social network, an analytics property, a company API —
# is configuration and belongs in a host or an overlay. Six such servers used to
# ship here, which meant a stranger's every activation printed six warnings about
# credentials for services they had never signed up to, with no option to stop it.
{ lib, config, ... }:
let
  nixosCfg = config;
  cfg = config.features.fluteos.claude-code;
in
{
  imports = [ ./options.nix ];

  config = lib.mkIf cfg.enable {
    # --- What FluteOS itself registers -------------------------------------
    features.fluteos.claude-code.mcpServers = lib.mkMerge [
      (lib.mkIf cfg.codeSearch.enable {
        # No secret: endpoints only. The collection is auto-keyed per repository
        # by path hash (code_chunks_<md5(path)>), so ONE registration serves every
        # codebase and no project needs its own .mcp.json.
        claude-context = {
          args = [
            "-y"
            "-p"
            "@zilliz/claude-context-mcp@latest"
            "-p"
            "ajv"
            "-p"
            "ajv-formats"
            "claude-context-mcp"
          ];
          env = {
            EMBEDDING_PROVIDER = "Ollama";
            EMBEDDING_MODEL = cfg.codeSearch.embeddingModel;
            EMBEDDING_DIMENSION = toString cfg.codeSearch.embeddingDimension;
            EMBEDDING_BATCH_SIZE = toString cfg.codeSearch.embeddingBatchSize;
            OLLAMA_HOST = cfg.codeSearch.ollamaHost;
            OLLAMA_REQUEST_TIMEOUT = "300000";
            MILVUS_ADDRESS = cfg.codeSearch.milvusAddress;
          };
        };
      })
      {
        perplexity = {
          args = [ "-y" "@perplexity-ai/mcp-server" ];
          env.PERPLEXITY_API_KEY = "%{perplexity-api-key}";
          secrets = [ "perplexity-api-key" ];
          hint = "Create it (chmod 600) with an API key from https://perplexity.ai to enable web research.";
        };
      }
    ];

    home-manager.users.${config.features.base.system.user.name} = { pkgs, lib, ... }:
    let
      # Set window as urgent using NIRI_WINDOW_ID inherited from fish init
      claudeNotify = pkgs.writeShellScript "claude-notify" ''
        export NIRI="${pkgs.niri}/bin/niri"
        bash ${./fluteos-claude-notify.sh}
      '';
    in
    {
      home.packages = [
        pkgs.nodejs  # Required for MCP servers using npx
        (pkgs.writeShellScriptBin "claude" ''
          export PATH="${lib.makeBinPath [ pkgs.nodejs pkgs.bubblewrap pkgs.procps pkgs.socat ]}:$PATH"
          export DISABLE_AUTOUPDATER=1
          export DISABLE_INSTALLATION_CHECKS=1

          # 1Password service-account token for agents. Read from disk (0600, never
          # in nix-store/git) and exported ONLY into this claude process and its
          # subagents, so `op` reads scoped secrets with no desktop-app approval
          # popups. Your interactive shell `op` is untouched (full vaults + Touch ID).
          # Missing/empty file → no-op: falls back to the desktop app's per-call
          # approval. Rotation runbook: docs/runbooks/1password-service-account.md
          # 1Password service-account tokens live under one secrets dir (same
          # SECRET_DIR as claudeMcpSetup). The global token is the default; a group
          # that needs a different vault (the global service account may not be
          # able to read that vault, and the CLI cannot grant an existing service
          # account access to new vaults) drops its own token at
          # <group>/op-service-account-token, which wins when present.
          SECRET_DIR="${nixosCfg.features.fluteos.claude-code.secretsDir}"
          OP_TOKEN_FILE="$SECRET_DIR/op-service-account-token"
          if [ -n "''${WORKSPACE_GROUP:-}" ] \
            && [ -s "$SECRET_DIR/''${WORKSPACE_GROUP}/op-service-account-token" ]; then
            OP_TOKEN_FILE="$SECRET_DIR/''${WORKSPACE_GROUP}/op-service-account-token"
          fi
          if [ -s "$OP_TOKEN_FILE" ]; then
            export OP_SERVICE_ACCOUNT_TOKEN="$(cat "$OP_TOKEN_FILE")"
          fi

          # Workspace-aware launch: when run inside a project (WORKSPACE_AGENT_DIR set
          # and the directory exists), cd into agent/ so .claude/skills and CLAUDE.md
          # are picked up, and expose source/docs/resources via --add-dir.
          ADD_ARGS=()
          if [ -n "''${WORKSPACE_AGENT_DIR:-}" ] && [ -d "$WORKSPACE_AGENT_DIR" ]; then
            # cd is the only way Claude Code picks up project-local .claude/skills
            # and CLAUDE.md. If it fails (permissions, race), abort loudly — running
            # without project context silently is worse than crashing.
            cd "$WORKSPACE_AGENT_DIR" || {
              echo "claude: failed to cd into $WORKSPACE_AGENT_DIR" >&2
              exit 1
            }
            for d in "$WORKSPACE_SOURCE_DIR" "$WORKSPACE_DOCS_DIR" "$WORKSPACE_RESOURCES_DIR"; do
              [ -n "$d" ] && [ -d "$d" ] && ADD_ARGS+=(--add-dir "$d")
            done
          fi

          # Tell the terminal "Claude is running here" via OSC 1337 SetUserVar.
          # WezTerm reads this to label the tab/window. Cleared on exit.
          if [ -t 1 ]; then
            printf '\033]1337;SetUserVar=agent_kind=%s\007' "$(printf claude | base64 -w0)"
            ${pkgs.nodejs}/bin/npx --yes @anthropic-ai/claude-code@latest "''${ADD_ARGS[@]}" "$@"
            rc=$?
            printf '\033]1337;SetUserVar=agent_kind=\007'
            exit $rc
          fi
          exec ${pkgs.nodejs}/bin/npx --yes @anthropic-ai/claude-code@latest "''${ADD_ARGS[@]}" "$@"
        '')
      ];

      # User-global skills, available in every session regardless of project.
      #
      # Only skills that document FluteOS itself ship here, all named fluteos-*
      # so their provenance is obvious. fluteos-agent-run explains
      # the fluteos agent subsystem (fluteos-agent-launch/-send plus raw
      # `wezterm cli`), so it is product. A runbook for someone's own server is
      # not, and arrives through extraSkills instead.
      home.file.".claude/skills/fluteos-agent-run/SKILL.md".source =
        ./skills/fluteos-agent-run/SKILL.md;

      # Host-supplied skills. Carried by an inline module rather than assigned
      # here: Nix merges a dotted `home.file.X` with a literal attrset, but not
      # with a computed one, so the module system has to do the merging.
      imports = [{
        home.file = lib.mapAttrs'
          (name: src: lib.nameValuePair ".claude/skills/${name}/SKILL.md" { source = src; })
          nixosCfg.features.fluteos.claude-code.extraSkills;
      }];

      # MCP servers register at activation time. Secrets are read from disk so
      # they never enter /nix/store or git history. A server whose secret is
      # missing is skipped with a warning — Claude Code still works without it,
      # and no server can take another one down.
      home.activation.claudeMcpSetup = lib.hm.dag.entryAfter [ "writeBoundary" ] (
        import ./mcp-setup.nix {
          inherit lib pkgs;
          cfg = nixosCfg.features.fluteos.claude-code;
        }
      );

      # ~/.claude/settings.json is written, not symlinked — see ./settings.nix.
      # After linkGeneration so the symlink an earlier generation left there is
      # already gone by the time the merge runs.
      home.activation.claudeSettings = lib.hm.dag.entryAfter [ "linkGeneration" ] (
        import ./settings.nix {
          inherit lib pkgs nixosCfg claudeNotify;
        }
      );
    };
  };
}
